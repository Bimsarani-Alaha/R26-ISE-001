# Relative paths resolve against STYLE_BASE_DIR (the model project directory).
# Set STYLE_BASE_DIR explicitly when deploying an installed wheel elsewhere.
# STYLE_BASE_DIR=C:/path/to/AI Style Recommendation Model
DATASET_PATH=data/product_full_updated.csv
IMAGES_DIR=Images
OCCASION_MAPPING_PATH=config/occasion_mapping.json
RESULTS_DIR=results
ARTIFACTS_DIR=artifacts
# Override the following only when using a different model location.
# RANKER_MODEL_PATH=artifacts/ranker
# FASHIONCLIP_MODEL_PATH=artifacts/fashionclip
FASHIONCLIP_CACHE_DIR=.cache/fashionclip

OLLAMA_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:7b
QWEN_STYLIST_MODEL=qwen3-vl:8b
QWEN_STYLIST_TIMEOUT=600
RANKER_ENABLED=true
RANKER_BATCH_SIZE=16
RANKER_CANDIDATES_PER_GROUP=50
FASHIONCLIP_ENABLED=true
FASHIONCLIP_BATCH_SIZE=8
FASHIONCLIP_THREADS=2
